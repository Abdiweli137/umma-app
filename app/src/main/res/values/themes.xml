<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Abdiwelizo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/emerald_primary</item>
        <item name="colorPrimaryVariant">@color/emerald_dark</item>
        <item name="colorOnPrimary">@color/surface_light</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/gold_accent</item>
        <item name="colorOnSecondary">@color/neutral_dark</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/neutral_dark</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/emerald_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
